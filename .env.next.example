# MARTCOM AI Next — plantilla de laboratorio. NO usar valores de producción.
APP_ENV=next
PORT=3000
NEXT_DATA_DIR=/app/data-next

CHATWOOT_BASE_URL=https://TU-CHATWOOT
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=REEMPLAZAR_INBOX_LAB
ALLOWED_INBOX_IDS=REEMPLAZAR_INBOX_LAB
CHATWOOT_AI_AGENT_ID=REEMPLAZAR_AGENT_LAB
CHATWOOT_ACCESS_TOKEN=REEMPLAZAR_TOKEN_LAB

OPENAI_API_KEY=REEMPLAZAR
OPENAI_MODEL=REEMPLAZAR

AI_PUBLIC_NAME=Mia de MARTCOM
AI_TIMEZONE=America/Mexico_City
AI_START_HOUR=7
AI_END_HOUR=22
AI_MAX_HISTORY_MESSAGES=50
AI_MESSAGE_BUFFER_MS=3000
AI_MAX_REPLY_CHARS=850

AUTO_HANDOFF=true
HANDOFF_WEEKDAY_AGENTS=
HANDOFF_SATURDAY_AGENTS=40:Alberto Gonzalez,26:Pamela Montiel,32:Vicente Martinez
HANDOFF_SUNDAY_AGENTS=25:Elizabeth Aguilera,20:Jonathan Nuñez,31:Tonatiuh Ramirez

WEBHOOK_SECRET=REEMPLAZAR_SECRETO_UNICO_NEXT
INSPECTOR_TOKEN=REEMPLAZAR_TOKEN_UNICO_NEXT
INSPECTOR_ADMIN_TOKEN=REEMPLAZAR_ADMIN_UNICO_NEXT
OPERATIONS_TOKEN=REEMPLAZAR_OPERATIONS_UNICO_NEXT

# No definir MEMORY_FILE/SALES_FILE/etc salvo necesidad especial.
# Si se definen, TODOS deben permanecer dentro de NEXT_DATA_DIR.
