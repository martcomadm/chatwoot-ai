# MARTCOM AI NEXT — variables de entorno (copiar a EasyPanel; NO commitear valores reales)
# Usar siempre tokens/secrets EXCLUSIVOS de NEXT, nunca los de producción.

# --- Aislamiento (obligatorias) ---
APP_ENV=next
NEXT_DATA_DIR=/app/data-next
# Inbox de laboratorio. Inbox 6 (compartido con producción) solo se permite con CHATWOOT_AI_AGENT_ID=53.
CHATWOOT_INBOX_ID=
ALLOWED_INBOX_IDS=

# --- Chatwoot (obligatorias) ---
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=
# Usuario IA exclusivo de NEXT. El 12 (AXEL IA de producción) está prohibido.
CHATWOOT_AI_AGENT_ID=
CHATWOOT_ACCESS_TOKEN=

# --- OpenAI (obligatorias) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Modelo para transcribir notas de voz (máx. 10 min). Default: gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Tiempo máximo por llamada a OpenAI (ms) y reintentos. Si la IA no responde a tiempo,
# Mia usa la respuesta de respaldo en lugar de quedarse callada.
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# --- Seguridad ---
# Secreto del webhook: POST /webhook/chatwoot?secret=<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Lectura del Inspector y de GET /memory/:id
INSPECTOR_TOKEN=
# Edición del Inspector y DELETE /memory/:id
INSPECTOR_ADMIN_TOKEN=
# Chats de prueba que el Inspector no cuenta (IDs separados por coma). También se pueden marcar desde el Inspector.
INSPECTOR_TEST_CONVERSATIONS=
# Operations: crea el primer administrador desde /operations y sirve como acceso
# de emergencia para scripts (cabecera x-operations-token). Si se omite usa INSPECTOR_ADMIN_TOKEN.
OPERATIONS_TOKEN=

# --- Operación ---
# Equipo de Atención a Clientes en Chatwoot (handoff especializado y expedientes completados)
CUSTOMER_SERVICE_TEAM_ID=
AUTO_HANDOFF=true
# Formato: id:Nombre,id:Nombre. Si se dejan vacías se usan las rotaciones predeterminadas
# (toda la semana: Pamela Montiel, Adriana Rangel, Jonathan Nuñez, Alberto Gonzalez).
HANDOFF_WEEKDAY_AGENTS=
HANDOFF_SATURDAY_AGENTS=
HANDOFF_SUNDAY_AGENTS=

# --- Comportamiento de Mia (opcionales, se muestran los valores por defecto) ---
AI_PUBLIC_NAME=Mia de MARTCOM
AI_INTRO_AGENTS=Mia de MARTCOM
AI_TIMEZONE=America/Mexico_City
# Horario de Mia: días=inicio-fin (0=domingo … 6=sábado). Días ausentes = cerrado.
AI_SCHEDULE=0-6=7-21
AI_MAX_HISTORY_MESSAGES=50
AI_MESSAGE_BUFFER_MS=3000
AI_MAX_REPLY_CHARS=850
AI_ASSIGNED_LABEL=asignado
AI_UNATTENDED_LABEL=sin_atender
AI_VALIDATION_LABEL=validacion
INSPECTOR_MAX_EVENTS_PER_CONVERSATION=200
PORT=3000

# --- Diagnóstico ---
# 1 = activa trazas "INE TRACE" en logs y eventos de depuración en el Inspector
DEBUG_TRACE=

# --- Rutas de archivos (opcionales; deben quedar dentro de NEXT_DATA_DIR) ---
# MEMORY_FILE= AGENT_ROTATION_FILE= HANDOFF_ROTATION_FILE= HUMAN_HANDOFF_ROTATION_FILE= INSPECTOR_EVENTS_FILE= HANDOFF_CONFIG_FILE= SALES_FILE=
# Seguimiento cuando el cliente deja de contestar: minutos después de la última respuesta de Mia.
# Todo ocurre dentro de la ventana de 24 h de WhatsApp; al cerrarse sin respuesta se pone "no_contesta".
FOLLOWUP_ENABLED=true
FOLLOWUP_MINUTES=20,180,1200

# --- Plantillas aprobadas de WhatsApp (nombre en Twilio; vacío = desactivada) ---
# Deben estar sincronizadas en el inbox de Chatwoot (Configuración del inbox → plantillas).
# TEMPLATE_VALIDITY=vigencia1          # vigencia lista y el cliente está fuera de las 24 h
# TEMPLATE_REFERRAL=recomendacion2     # recomendación al terminar el proceso
# TEMPLATE_FOLLOWUP_24H=saludodia3     # seguimiento al cerrarse la ventana de 24 h

# Avisos de Operations (Web Push). Opcional: si no se definen, NEXT genera las llaves y las guarda
# en NEXT_DATA_DIR/ops-push.json. Si se cambian, cada persona debe volver a "Activar avisos".
# OPS_VAPID_PUBLIC_KEY=
# OPS_VAPID_PRIVATE_KEY=
# OPS_VAPID_SUBJECT=https://martcom-econtact.mx

# Atención humana (cliente pide una persona, frustración, proveedor, casos que la IA no resuelve).
# Las solicitudes de llamada siguen con la rotación de asesores (HANDOFF_*_AGENTS / Operaciones).
HUMAN_HANDOFF_AGENTS=62:Jaqueline Juárez,58:Erika Balanzario,60:Ricardo Guzman,59:Brenda Torres
